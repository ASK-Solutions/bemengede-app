# Copy to .env, then restart `npx expo start` after any change.
# EXPO_PUBLIC_* values are compiled into the app bundle: never put secrets here.

# Backend API. Android emulator reaches your machine at 10.0.2.2; iOS simulator can use localhost;
# a physical device needs your computer's LAN IP (and `php artisan serve --host=0.0.0.0`).
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# Web frontend.
EXPO_PUBLIC_WEB_URL=http://localhost:5173

# Google sign-in (optional). OAuth client IDs from Google Cloud Console. Add all of them to the API's
# GOOGLE_CLIENT_IDS too. Google sign-in needs a development or store build; it doesn't work in Expo Go.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
